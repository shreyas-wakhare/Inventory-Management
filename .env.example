# Environment Variables — SER Inventory Management System
# Copy this file to `.env` (root), `backend/.env`, and `frontend/.env.local` as needed.
# Never commit real secrets or production credentials.

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
APP_NAME="SER Inventory Management System"
APP_ENV=development
DEBUG=true

# ------------------------------------------------------------------------------
# Backend (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Security (replace with strong random values in production)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# Database (PostgreSQL — managed in backend/database/)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ser_inventory
POSTGRES_USER=ser_admin
POSTGRES_PASSWORD=change-me-in-local-dev
DATABASE_URL=postgresql+psycopg://ser_admin:change-me-in-local-dev@localhost:5432/ser_inventory

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="SER Inventory Management System"

# ------------------------------------------------------------------------------
# Future AI Module (Isolated — Disabled by default)
# ------------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=

