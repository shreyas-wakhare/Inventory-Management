APP_NAME="SER Inventory Management System API"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL
DATABASE_URL=postgresql+psycopg://ser_admin:change-me-in-local-dev@localhost:5432/ser_inventory
DB_ECHO=false

# Security
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Module (isolated)
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=

